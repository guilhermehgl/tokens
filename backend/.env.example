# Configurações existentes (preencher apenas no .env local)
PORT=3003
MONGO_URI=
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# WhatsApp: demonstração via Vonage Messages API Sandbox
VONAGE_APPLICATION_ID=
# Caminho relativo ao diretório backend ou caminho absoluto; nunca colocar a chave neste arquivo.
VONAGE_PRIVATE_KEY_PATH=secrets/vonage-whatsapp.key
VONAGE_WHATSAPP_FROM=
VONAGE_MESSAGES_API_URL=https://messages-sandbox.nexmo.com/v1/messages
# Opcional: JSON telefone E.164 sem + -> identificador exato autorizado; só se aplica ao Sandbox.
VONAGE_SANDBOX_RECIPIENT_OVERRIDES={}
# URL HTTPS pública da imagem institucional. Vazio mantém envio somente de texto.
WHATSAPP_TOKEN_IMAGE_URL=
