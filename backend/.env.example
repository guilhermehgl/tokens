PORT=3003
MONGO_URI=mongodb://127.0.0.1:27017/portal_tokens_demo
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173

# Integrações preservadas no código, não utilizadas pela geração de tokens.
# Não são necessárias para iniciar ou utilizar o portal.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY_PATH=secrets/whatsapp.key
VONAGE_WHATSAPP_FROM=
VONAGE_MESSAGES_API_URL=https://messages-sandbox.nexmo.com/v1/messages
VONAGE_SANDBOX_RECIPIENT_OVERRIDES={}
WHATSAPP_TOKEN_IMAGE_URL=

# Proxy desativado por padrão. Informe IPs/CIDRs conhecidos, nunca true.
TRUST_PROXY=
# Ative somente quando a API estiver exposta por HTTPS.
HTTPS_ENABLED=false
